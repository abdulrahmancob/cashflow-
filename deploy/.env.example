# Copy to deploy/.env on the server and fill secrets.
# NEVER commit deploy/.env

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
DATA_ROOT=/data

# ---------------------------------------------------------------------------
# PostgreSQL (internal Docker network only — never published)
# ---------------------------------------------------------------------------
POSTGRES_USER=cashflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cashflow
# Used by app containers (hostname = compose service name)
CASHFLOW_DATABASE_URL=postgresql://cashflow:CHANGE_ME_STRONG_PASSWORD@postgres:5432/cashflow

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------
TZ=Africa/Cairo
GIT_SHA=unknown
CASHFLOW_FORECAST_FROM_DB=1
CASHFLOW_OPS_DRY_RUN=0
CASHFLOW_OPS_SKIP_SCRAPERS=0
CASHFLOW_OPS_LOOKBACK_DAYS=14
CASHFLOW_OPS_NOTIFY_WEBHOOK=
TRACKER_XLSX=/data/webpt/Transaction Tracker 2026.xlsx
WEBPT_OCR_ENABLED=true

# Portal auth (JWT + seeded users; create-if-missing on migrate/API startup)
CASHFLOW_JWT_SECRET=CHANGE_ME_LONG_RANDOM
CASHFLOW_JWT_TTL_SECONDS=43200
CASHFLOW_SEED_ADMIN_EMAIL=abdelrahman.hamdy@cobsolution.com
CASHFLOW_SEED_ADMIN_PASSWORD=Rcm@112233
CASHFLOW_SEED_ADMIN_NAME=Abdelrahman Hamdy
CASHFLOW_SEED_FINANCE_EMAIL=mostafa.ezz@cobsolution.com
CASHFLOW_SEED_FINANCE_PASSWORD=F@12345
CASHFLOW_SEED_FINANCE_NAME=Mostafa Ezz
CASHFLOW_SEED_POSTING_EMAIL=billing7@cobsolution.com
CASHFLOW_SEED_POSTING_PASSWORD=B@12345
CASHFLOW_SEED_POSTING_NAME=Ahmed Daker

# ---------------------------------------------------------------------------
# WebPT scraper
# ---------------------------------------------------------------------------
WEBPT_USERNAME=
WEBPT_PASSWORD=
# WEBPT_STORAGE_STATE=/data/webpt/storage_state.json

# ---------------------------------------------------------------------------
# RevFlow scraper
# ---------------------------------------------------------------------------
REVFLOW_USERNAME=
REVFLOW_PASSWORD=
REVFLOW_HEADLESS=true
REVFLOW_STORAGE_STATE_PATH=/data/revflow/storage_state.json
# Gmail OAuth for automatic IP registration (desktop client + authorized token)
GMAIL_CREDENTIALS_PATH=/data/revflow/credentials.json
GMAIL_TOKEN_PATH=/data/revflow/gmail_token.json
GMAIL_POLL_TIMEOUT_SEC=300
GMAIL_POLL_INTERVAL_SEC=5
# Fallback when Gmail OAuth token is missing: paste the email link into this file
REVFLOW_IP_LINK_FILE=/data/revflow/pending_ip_link.txt

# ---------------------------------------------------------------------------
# Waystar scraper
# ---------------------------------------------------------------------------
WAYSTAR_USER=
WAYSTAR_PASS=
WAYSTAR_CUST_ID=
WAYSTAR_SECURITY_ANSWERS=

# ---------------------------------------------------------------------------
# Snowflake KPI (optional; staging only)
# ---------------------------------------------------------------------------
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=

# ---------------------------------------------------------------------------
# OCR / misc
# ---------------------------------------------------------------------------
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
# WEBPT_TESSERACT_CMD=tesseract
