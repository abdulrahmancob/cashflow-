REVFLOW_USERNAME=your.username
REVFLOW_PASSWORD=your-password
REVFLOW_COMPANY_ID=11067
REVFLOW_USER_ID=46136
REVFLOW_CLINIC_CODE=PV4
REVFLOW_HEADLESS=false

# Gmail OAuth (desktop app credentials from Google Cloud Console)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=gmail_token.json
GMAIL_POLL_TIMEOUT_SEC=300
GMAIL_POLL_INTERVAL_SEC=5

# Export tuning
REVFLOW_EXPORT_DELAY_SEC=3.5
REVFLOW_EXPORT_DELAY_JITTER_SEC=1.5
REVFLOW_EXPORT_TIMEOUT_SEC=120
REVFLOW_EXPORT_BUTTON_WAIT_SEC=10
REVFLOW_ACTION_DELAY_SEC=1.0
REVFLOW_EXPORT_RETRY_MAX=2
REVFLOW_REAUTH_COOLDOWN_SEC=15
REVFLOW_SESSION_REFRESH_EVERY_N=25

# Setup:
#   pip install -r requirements.txt
#   playwright install chromium
#   copy .env.example .env  (fill in credentials)
#   python scraper.py login
#   python scraper.py discover-eobs --from-date 06/01/2026 --to-date 06/30/2026 --output output/jun_2026
#   python scraper.py export-all --output output/jun_2026
