# Snowflake connection (key-pair / JWT auth)
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=YOUR_USERNAME
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=YOUR_DATABASE
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=

# Path to encrypted PKCS#8 private key (relative to this package or absolute)
SNOWFLAKE_PRIVATE_KEY_PATH=keys/snowflake_key.p8

# Passphrase used when generating snowflake_key.p8 (also in keys/.passphrase)
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Optional default SQL when --sql / --sql-file omitted
# SNOWFLAKE_SQL=SELECT CURRENT_TIMESTAMP() AS pulled_at, CURRENT_USER() AS snowflake_user
