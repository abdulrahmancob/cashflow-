# Optional overrides (defaults come from cashflow_db/.env + repo paths)
# CASHFLOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cashflow

# Engine behaviour
# CASHFLOW_OPS_DRY_RUN=0
# CASHFLOW_OPS_SKIP_SCRAPERS=0
# CASHFLOW_OPS_LOOKBACK_DAYS=14
# CASHFLOW_OPS_STAGE_STALE_SEC=1800
# CASHFLOW_OPS_RETRY_DELAY_HOURS=1
# CASHFLOW_OPS_NOTIFY_WEBHOOK=https://outlook.office.com/webhook/...
# CASHFLOW_OPS_ARTIFACTS_DIR=

# Validate Sources thresholds
# CASHFLOW_OPS_SCHEDULE_DROP_STOP_PCT=0.15
# CASHFLOW_OPS_SCHEDULE_DROP_ALERT_PCT=0.05
# CASHFLOW_OPS_PAYMENTS_DROP_ALERT_PCT=0.30
# CASHFLOW_OPS_FORECAST_CASH_DROP_ALERT_PCT=0.40
